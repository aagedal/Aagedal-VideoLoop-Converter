          "stringUnit": {
            "state": "translated",
            "value": "Utvidet PSNR fra Fraunhofer HHI. Persepsjonsvektet PSNR-metrikk målt i dB. Verdier over 42 dB regnes som visuelt tapsfrie."
          }
        }
      }
    },
