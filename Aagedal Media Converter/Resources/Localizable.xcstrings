    "PRESET_ANIMATED_STILL_DESCRIPTION" : {
      "comment" : "Description for Animated Still preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animated still image format. Chose between GIF, AVIF, Animated PNG."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animasjonsformat for stillbilder. Velg mellom GIF, AVIF, og animert PNG."
          }
        }
      }
    },
    "PRESET_AUDIO_AAC_STEREO_DESCRIPTION" : {
      "comment" : "Description for Audio AAC Stereo preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio only stereo down mix AAC-file."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare lyd. Stereo nedmiks AAC-fil."
          }
        }
      }
    },
    "PRESET_AUDIO_WAV_DESCRIPTION" : {
      "comment" : "Description for Audio WAV preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio only uncompressed WAV, keeping all audio channels if possible."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare lyd. Ukomprimert WAV, beholder alle lydkanaler hvis mulig."
          }
        }
      }
    },
    "PRESET_AV1_DESCRIPTION" : {
      "comment" : "Description for AV1 preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next-generation AV1 encoding using SVT-AV1 encoder. Excellent compression efficiency with 10-bit support. Software encoding only - no hardware acceleration available on macOS."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neste generasjons AV1-koding med SVT-AV1-enkoder. Utmerket komprimeringseffektivitet med 10-bit støtte. Kun programvarekoding - ingen maskinvareakselerasjon tilgjengelig på macOS."
          }
        }
      }
    },
    "PRESET_CUSTOM_DESCRIPTION" : {
      "comment" : "Description for Custom preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom FFMPEG preset. You do not need to write ffmpeg or input parameters. Only the output parameters. Ignores global metadata removal tags"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personlig forhåndsinnstilling. Du trenger ikke skrive 'ffmpeg' eller input-parametre. Kun enkoder-parametre. Ignorerer globale parametre for fjerning av metadata."
          }
        }
      }
    },
    "PRESET_H264_DESCRIPTION" : {
      "comment" : "Description for H.264 preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Highly compatible H.264/AVC encoding. Choose between fast hardware encoding (VideoToolbox) or quality-focused software encoding (libx264) with CRF control. Supports MP4, MOV, and MKV containers."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svært kompatibel H.264/AVC-koding. Velg mellom rask maskinvarekoding (VideoToolbox) eller kvalitetsfokusert programvarekoding (libx264) med CRF-kontroll. Støtter MP4, MOV og MKV-kontainere."
          }
        }
      }
    },
    "PRESET_H265_DESCRIPTION" : {
      "comment" : "Description for H.265 preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modern H.265/HEVC encoding with 10-bit support. Hardware encoding via VideoToolbox for speed, or software encoding (libx265) for maximum compression efficiency."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderne H.265/HEVC-koding med 10-bit støtte. Maskinvarekoding via VideoToolbox for hastighet, eller programvarekoding (libx265) for maksimal komprimeringseffektivitet."
          }
        }
      }
    },
    "PRESET_PRORES_DESCRIPTION" : {
      "comment" : "Description for ProRes preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ProRes (yuv422p10) for edit-friendly masters. Includes the first video and audio streams, retains 24-bit PCM audio, and targets standard ProRes bitrates."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ProRes (yuv422p10) for redigeringsklare mastere. Inkluderer første video- og lydspor, beholder 24-bit PCM-lyd og sikter mot standard ProRes-bithastigheter."
          }
        }
      }
    },
    "PRESET_PROXY_DESCRIPTION" : {
      "comment" : "Description for Proxy preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lightweight proxy format for offline editing. Supports HEVC, ProRes Proxy, or DNx codecs with configurable resolution limits. Retains all audio channels as uncompressed PCM."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lett proxy-format for offline-redigering. Støtter HEVC, ProRes Proxy eller DNx-kodeker med justerbare oppløsningsgrenser. Beholder alle lydkanaler som ukomprimert PCM-lyd."
          }
        }
      }
    },
    "PRESET_STREAM_COPY_DESCRIPTION" : {
      "comment" : "Description for Stream Copy preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy audio and video streams into a new file. Most useful when combined with trimming or merging."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopier lyd og videostrømmer inn i en ny fil. Mest nyttig i kombinasjon med trimming eller sammenslåing."
          }
        }
      }
    },
    "PRESET_TV_AVC_INTRA_DESCRIPTION" : {
      "comment" : "Description for TV AVC-Intra preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broadcast delivery format in MXF container. AVC-Intra (10-bit 4:2:2) with configurable class (50/100/200 Mbps), resolution, and framerate. Outputs 4, 8, or 16 mono audio channels as 24-bit PCM."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format for TV-leveranse i MXF-kontainer. AVC-Intra (10-bit 4:2:2) med konfigurerbar klasse (50/100/200 Mbps), oppløsning og bildefrekvens. Utgir 4, 8 eller 16 mono-lydkanaler som 24-bit PCM."
          }
        }
      }
    },
    "PRESET_TV_HEVC_DESCRIPTION" : {
      "comment" : "Description for TV HEVC preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broadcast delivery format. Hardware HEVC (10-bit 4:2:2) with configurable resolution and framerate. Preserves all audio channels as 24-bit PCM. Bitrate scales automatically with resolution."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format for TV-leveranse. Maskinvareakselerert HEVC (10-bit 4:2:2) med konfigurerbar oppløsning og bildefrekvens. Beholder alle lydkanaler som 24-bit PCM. Bitrate skalerer automatisk med oppløsning."
          }
        }
      }
    },
    "PRESET_VIDEO_LOOP_DESCRIPTION" : {
      "comment" : "Description for VideoLoop preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimized for seamless silent loops. Encodes with x264 at CRF 23 (3–9 Mbps variable bitrate), strips audio, and limits the shortest edge to 1080 px for web playback."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimalisert for sømløse, stille looper. Koder med x264 på CRF 23 (3–9 Mbps variabel bithastighet), fjerner lyd og begrenser korteste kant til 1080 piksler for web-avspilling."
          }
        }
      }
    },
    "PRESET_VIDEO_LOOP_WITH_SOUND_DESCRIPTION" : {
      "comment" : "Description for VideoLoop with sound preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seamless loops that retain audio. Encodes video with x264 at CRF 23 (3–9 Mbps), includes all audio tracks as 128 kbps AAC, and limits the shortest edge to 1080 px."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sømløse looper med lyd. Koder video med x264 på CRF 23 (3–9 Mbps), inkluderer alle lydspor som 128 kbps AAC, samtidig som korteste kant begrenses til 1080 piksler."
          }
        }
      }
    },
    "Presets" : {
