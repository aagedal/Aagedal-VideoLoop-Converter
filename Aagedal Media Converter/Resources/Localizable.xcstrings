    "No executable is available from the selected source. Check this tool’s settings.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kjørbar fil er tilgjengelig fra den valgte kilden. Kontroller innstillingene for verktøyet."
          }
        }
      }
    },
    "The selected file is missing or is not executable.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den valgte filen mangler eller er ikke kjørbar."
          }
        }
      }
    },
    "The tool exited successfully without version information.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verktøyet avsluttet uten feil, men ga ingen versjonsinformasjon."
          }
        }
      }
    },
    "The version check failed. Review the selected binary in this tool’s settings.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Versjonskontrollen mislyktes. Kontroller den valgte programfilen i innstillingene for verktøyet."
          }
        }
      }
    },
    "The tool could not complete its version check within five seconds. Check its permissions and dependencies.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verktøyet kunne ikke fullføre versjonskontrollen innen fem sekunder. Kontroller tilgangsrettigheter og avhengigheter."
          }
        }
      }
    },
    "Check the active bundled, Homebrew, or custom tools selected in Settings. Each version check has a five-second limit.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroller de aktive medfølgende, Homebrew-installerte eller egendefinerte verktøyene som er valgt i Innstillinger. Hver versjonskontroll har en tidsgrense på fem sekunder."
          }
        }
      }
    },
    "The bundled FFmpeg is sufficient for standard conversions. Optional tools are only needed for their related features; select or install them in Downloads, Upload, Transcription, OCR, or Analytics settings.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Medfølgende FFmpeg er tilstrekkelig for vanlige konverteringer. Valgfrie verktøy trengs bare for tilhørende funksjoner. Velg eller installer dem i innstillingene for Nedlastinger, Opplasting, Transkripsjon, OCR eller Analyse."
          }
        }
      }
    },
    "Could not create temporary storage for AV2 chunks: %@. Check available disk space and temporary-folder permissions, then try again.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke opprette midlertidig lagring for AV2-segmenter: %@. Kontroller ledig diskplass og tilgang til mappen for midlertidige filer, og prøv igjen."
          }
        }
      }
    },
    "Failed to append timecode samples to the capture writer.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke skrive tidskode til skjermopptaket."
          }
        }
      }
    },
    "Timed out while writing the final screen recording frames. The file may be incomplete.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidsavbrudd under skriving av de siste bildene i skjermopptaket. Filen kan være ufullstendig."
          }
        }
      }
    },
    "HDR Display P3 (macOS 26+)" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR Display P3 (macOS 26+)"
          }
        }
      }
    },
    "SDR (Display)" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SDR (skjerm)"
          }
        }
      }
    },
    "Visually lossless ProRes 4444 for grading. Variable frame rate (VFR) keeps files smaller when the screen is static. Not flagged as a growing clip, so DaVinci Resolve won't poll it for updates while recording — best for importing afterward." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visuelt tapsfri ProRes 4444 for fargekorrigering. Variabel bildefrekvens (VFR) gir mindre filer når skjermen er statisk. Klippet er ikke merket som voksende, så DaVinci Resolve ser ikke etter oppdateringer under opptak – best egnet for import etterpå."
          }
        }
      }
    },
    "Hardware HEVC 10-bit 4:2:2; source format determines chroma. Variable frame rate, not flagged as a growing clip — best for importing after recording." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maskinvarekodet HEVC 10-bit 4:2:2; kildeformatet avgjør fargesamplingen. Variabel bildefrekvens, uten merking som voksende klipp – best egnet for import etter opptak."
          }
        }
      }
    },
    "Edit while recording in DaVinci Resolve & Premiere. ProRes 4444 at a constant frame rate (CFR) — visually lossless, but because ProRes can't compress duplicate frames, a mostly-static screen makes very large files. Needs a ProRes hardware encoder (M1 Pro/Max or later) for high frame rates." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rediger under opptak i DaVinci Resolve og Premiere. ProRes 4444 med konstant bildefrekvens (CFR) er visuelt tapsfri, men siden ProRes ikke kan komprimere duplikatbilder, gir en stort sett statisk skjerm svært store filer. Høy bildefrekvens krever en ProRes-maskinvarekoder (M1 Pro/Max eller nyere)."
          }
        }
      }
    },
    "Edit while recording with maximum compatibility. Hardware H.264, fragmented .mov." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rediger under opptak med maksimal kompatibilitet. Maskinvarekodet H.264, fragmentert .mov."
          }
        }
      }
    },
    "Edit while recording in DaVinci Resolve & Premiere. Hardware HEVC 10-bit 4:2:2, fragmented .mov." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rediger under opptak i DaVinci Resolve og Premiere. Maskinvarekodet HEVC 10-bit 4:2:2, fragmentert .mov."
          }
        }
      }
    },
