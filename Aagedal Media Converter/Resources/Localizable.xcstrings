    "yt-dlp only strips characters illegal on macOS (just '/' and NUL). Filenames may still break on Windows or NTFS drives.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp fjerner bare tegn som er ugyldige i macOS ('/' og NUL). Filnavnene kan fortsatt gi problemer i Windows eller på NTFS-disker."
          }
        }
      }
    },
    "Strips characters Windows rejects (< > : \" / \\ | ? *) and trailing space/period. Unicode letters, including æ, ø, å, and CJK scripts, are preserved.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner tegn som Windows avviser (< > : \" / \\ | ? *) samt mellomrom og punktum til slutt. Unicode-bokstaver, inkludert æ, ø, å og kinesiske, japanske og koreanske tegn, beholdes."
          }
        }
      }
    },
    "Keeps only ASCII letters, digits, underscore, hyphen, and period. Non-Latin scripts and many accented letters are dropped (e.g. ø → empty, é → e).": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholder bare ASCII-bokstaver, sifre, understrek, bindestrek og punktum. Ikke-latinske tegn og mange bokstaver med aksent fjernes (f.eks. ø → tomt, é → e)."
          }
        }
      }
    },
