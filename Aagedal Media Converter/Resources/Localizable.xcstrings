          }
        }
      }
    },
    "Removes film grain from the source before encoding, then embeds instructions for the decoder to recreate similar grain during playback. This dramatically improves compression of grainy footage since the encoder no longer wastes bits on random noise. Choose a level that matches your source material’s grain intensity." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner filmkorn fra kilden før koding, og bygger deretter inn instruksjoner slik at dekoderen kan gjenskape lignende korn under avspilling. Dette forbedrer komprimeringen av kornete materiale dramatisk, siden koderen ikke lenger bruker bits på tilfeldig støy. Velg et nivå som samsvarer med kornintensiteten i kildematerialet."
          }
        }
      }
    },
    "Renderer" : {
      "comment" : "A section of the waveform settings view that lets the user choose the waveform rendering engine.",
      "isCommentAutoGenerated" : true
    },
    "Replace spaces with underscores" : {
      "comment" : "A toggle that lets the user decide whether to replace spaces in file names with underscores.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
