    "Optimized for 4K/UHD content. Use for high-resolution videos.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimalisert for 4K/UHD-innhold. Brukes til videoer med høy oppløsning."
          }
        }
      }
    },
    "Peak Signal-to-Noise Ratio. Traditional mathematical metric measured in dB. Higher values indicate better quality. Typical range: 30-50 dB.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Peak Signal-to-Noise Ratio. Tradisjonell matematisk metrikk målt i dB. Høyere verdier betyr bedre kvalitet. Typisk område: 30–50 dB."
          }
        }
      }
    },
    "Penalizes enhancement artifacts. Use when encoder may sharpen or upscale.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gir trekk for artefakter fra bildeforbedring. Brukes når koderen kan skarpe opp eller oppskalere."
          }
        }
      }
    },
    "Perceptual quality metric by Cloudflare. Measures structural similarity on a 0-100 scale. Scores above 70 indicate good quality. Requires the external ssimulacra2_rs binary.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Perseptuell kvalitetsmetrikk fra Cloudflare. Måler strukturell likhet på en skala fra 0 til 100. Resultater over 70 tyder på god kvalitet. Krever det eksterne programmet ssimulacra2_rs."
          }
        }
      }
    },
