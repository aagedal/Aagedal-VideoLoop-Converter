    "Content Title" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innholdstittel"
          }
        }
      }
    },
    "Control + R to load a new random tip" : {
      "comment" : "A footnote",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Control + R laster inn et nytt tilfeldig tips"
          }
        }
      }
    },
    "Control which metadata controls are shown on each video row in the queue." : {
      "comment" : "A description of what the \"Queue Row Display\" section in the metadata settings view does.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroller hvilke metadatakontroller som vises på hver videorad i køen."
          }
        }
      }
    },
    "Controls how the extra bits from Variance Boost are distributed. Linear applies a uniform boost proportional to detail complexity. Moderate concentrates more of the boost on medium-to-high complexity areas. Aggressive focuses the boost heavily on the most complex areas, which is effective for highly detailed content." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styrer hvordan de ekstra bitsene fra Varians-boost fordeles. Lineær gir en jevn økning proporsjonal med detaljkompleksitet. Moderat konsentrerer mer av økningen på områder med middels til høy kompleksitet. Aggressiv fokuserer økningen kraftig på de mest komplekse områdene, noe som er effektivt for svært detaljert innhold."
          }
        }
      }
    },
    "Controls the maximum characters per subtitle line. Default is 42, which works well for most video players. Use lower values for mobile devices." : {
      "comment" : "A description of the slider that controls the maximum number of characters per subtitle line.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollerer maksimalt antall tegn per undertekstlinje. Standard er 42, som fungerer bra for de fleste videospillere. Bruk lavere verdier for mobile enheter."
          }
        }
      }
    },
    "Controls the time spent optimizing each frame. Lower values (slower) produce better quality and smaller files at the same CRF, but take significantly longer to encode. Preset 6 offers a good balance. Presets 0–4 are best reserved for final encodes where encoding time is not a concern." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styrer tiden som brukes på å optimalisere hvert bilde. Lavere verdier (langsommere) gir bedre kvalitet og mindre filer ved samme CRF, men tar vesentlig lengre tid å kode. Forhåndsinnstilling 6 gir en god balanse. Forhåndsinnstilling 0–4 passer best for endelige kodinger der tidsbruk ikke er et problem."
          }
        }
      }
    },
    "Controls transparency of the waveform over background images. Lower values let the background show through." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styrer gjennomsiktigheten til bølgeformen over bakgrunnsbilder. Lavere verdier lar bakgrunnen skinne gjennom."
          }
        }
      }
    },
    "Controls waveform animation smoothness. Higher frame rates increase render cost." : {
      "comment" : "A description of how to adjust the frame rate for waveform videos.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollerer hvor jevn bølgeformanimasjonen er. Høyere bildefrekvenser øker renderingskostnaden."
          }
        }
      }
    },
    "Controls what the Reset button does by default" : {
      "comment" : "A description of what happens when the \"Reset also clears trim, crop, and audio routing\" toggle is enabled.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styrer hva Tilbakestill-knappen gjør som standard"
          }
        }
      }
    },
