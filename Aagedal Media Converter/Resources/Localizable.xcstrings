    "PRESET_AV1_DESCRIPTION" : {
      "comment" : "Description for AV1 preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next-generation SVT-AV1 encoding with 10-bit support. The best compression efficiency in the app, but it is software only (no hardware acceleration on macOS)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neste generasjons SVT-AV1-koding med 10-bit støtte. Beste komprimeringseffektivitet i appen, men kun programvare (ingen maskinvareakselerasjon på macOS)."
          }
        }
      }
    },
    "PRESET_AV2_DESCRIPTION" : {
      "comment" : "Description for experimental AV2 preset",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Experimental AV2 encoding via the bundled avmenc (AOM AVM) encoder, parallelised across all CPU cores. Outputs a video-only .ivf bitstream, or a Matroska (.mkv) with audio. AV2 is very new and not previewable in-app yet — playback needs an AV2-capable decoder. For enthusiasts evaluating the next-generation codec."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksperimentell AV2-koding via den medfølgende avmenc-koderen (AOM AVM), parallellisert over alle CPU-kjerner. Gir en .ivf-bitstrøm med kun video, eller en Matroska (.mkv) med lyd. AV2 er svært nytt og kan ennå ikke forhåndsvises i appen – avspilling krever en AV2-kompatibel dekoder. For entusiaster som vil vurdere neste generasjons kodek."
          }
        }
      }
    },
    "PRESET_CUSTOM_DESCRIPTION" : {
      "comment" : "Description for Custom preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten custom presets (C1–C10) let you supply your own output arguments, suffixes, and extensions. Input parameters are handled for you, but note that -copy paths cannot combine with the crop or audio-routing toggles that live in Preset Settings."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti egendefinerte forhåndsinnstillinger (C1–C10) lar deg angi egne utdataargumenter, suffikser og filendelser. Input-parametere håndteres automatisk, men husk at -copy-kommandoer ikke fungerer sammen med avlings- eller lydrutingsbryterne i Forhåndsinnstillinger."
          }
        }
      }
    },
    "PRESET_DCP_DESCRIPTION" : {
      "comment" : "Description for DCP preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digital Cinema Package with JPEG 2000 video and 24-bit PCM audio in MXF containers, plus Interop DCP metadata (CPL, PKL, ASSETMAP). Configurable resolution (2K/4K Flat, Scope, or Full), frame rate, and bitrate. Uses DCI XYZ 12-bit color space for theatrical compliance."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digital Cinema Package med JPEG 2000-video og 24-bit PCM-lyd i MXF-containere, pluss Interop DCP-metadata (CPL, PKL, ASSETMAP). Konfigurerbar oppløsning (2K/4K Flat, Scope eller Full), bildefrekvens og bithastighet. Bruker DCI XYZ 12-bit fargerom for kinostandard-kompatibilitet."
          }
        }
      }
    },
    "PRESET_H264_DESCRIPTION" : {
      "comment" : "Description for H.264 preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Highly compatible H.264/AVC encoding with a choice between fast VideoToolbox hardware encoding or quality-focused libx264 software encoding with CRF control plus MP4, MOV, and MKV containers."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svært kompatibel H.264/AVC-koding med valg mellom rask VideoToolbox-maskinvarekoding eller kvalitetsfokusert libx264-programvarekoding med CRF-kontroll og støtte for MP4, MOV og MKV."
          }
        }
      }
    },
    "PRESET_H265_DESCRIPTION" : {
      "comment" : "Description for H.265 preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modern 10-bit H.265/HEVC encoding. Hardware encoding via VideoToolbox keeps exports quick, while libx265 software encoding can be chosen for maximum compression efficiency."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderne 10-bit H.265/HEVC-koding. VideoToolbox-maskinvarekoding gir raske eksporter, mens libx265-programvarekoding kan velges for maksimal komprimeringseffektivitet."
          }
        }
      }
    },
    "PRESET_IMAGE_SEQUENCE_DESCRIPTION" : {
      "comment" : "Description for Image Sequence preset",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PRESET_IMAGE_SEQUENCE_DESCRIPTION"
          }
        }
      }
    },
    "PRESET_IMF_J2K_DESCRIPTION" : {
      "comment" : "Description for IMF App 2e (JPEG 2000) preset",
      "shouldTranslate" : false
    },
    "PRESET_IMF_PRORES_DESCRIPTION" : {
      "comment" : "Description for IMF App 5 (ProRes) preset",
      "shouldTranslate" : false
    },
    "PRESET_PRORES_DESCRIPTION" : {
      "comment" : "Description for ProRes preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ProRes (yuv422p10) for edit-friendly masters. Includes the first video and audio streams, keeps 24-bit PCM audio, and targets standard ProRes bitrates. The default ProRes profile can be chosen in Preset Settings."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ProRes (yuv422p10) for redigeringsvennlige masterfiler. Inkluderer første video- og lydspor, beholder 24-bit PCM-lyd og sikter mot standard ProRes-bithastigheter. Standard ProRes-profil velges i Forhåndsinnstillinger."
          }
        }
      }
    },
    "PRESET_PROXY_DESCRIPTION" : {
      "comment" : "Description for Proxy preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lightweight proxy creation in HEVC, ProRes Proxy, or DNxHR with configurable resolution limits. Retains every audio channel as uncompressed PCM, which is ideal for offline editing and pairing with a dedicated Proxy sub-folder next to the source material."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lett proxy-eksport i HEVC, ProRes Proxy eller DNxHR med konfigurerbare oppløsningsgrenser. Beholder alle lydkanaler som ukomprimert PCM, ideelt for offline-redigering og bruk av en dedikert 'Proxy'-undermappe ved siden av kildefilene."
          }
        }
      }
    },
    "PRESET_STREAM_COPY_DESCRIPTION" : {
      "comment" : "Description for Stream Copy preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copies the existing audio and video streams into a new file. Its strength is keeping the original codecs, metadata, and extension, so it pairs well with trimming or merging tasks."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopierer lyd- og videostrømmene inn i en ny fil. Styrken er at original kodek, metadata og filendelse beholdes, så dette passer godt ved trimming eller sammenslåing."
          }
        }
      }
    },
    "PRESET_TV_AVC_INTRA_DESCRIPTION" : {
      "comment" : "Description for TV AVC-Intra preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broadcast delivery format in an MXF container. AVC-Intra 10-bit 4:2:2 offers selectable classes (50/100/200 Mbps), resolution, and frame rate plus 4/8/16 mono audio channels as 24-bit PCM."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV-leveranseformat i MXF-kontainer. AVC-Intra 10-bit 4:2:2 tilbyr valgfrie klasser (50/100/200 Mbps), oppløsning og bildefrekvens, samt 4/8/16 mono lydkanaler som 24-bit PCM."
          }
        }
      }
    },
    "PRESET_TV_HEVC_DESCRIPTION" : {
      "comment" : "Description for TV HEVC preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broadcast delivery format with hardware HEVC 10-bit 4:2:2, configurable resolution/framerate, automatic bitrate scaling, and preservation of all audio channels as 24-bit PCM."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV-leveranseformat med maskinvare HEVC 10-bit 4:2:2, konfigurerbar oppløsning og bildefrekvens, automatisk bitrate-skala og bevaring av alle lydkanaler som 24-bit PCM."
          }
        }
      }
    },
    "PRESET_VIDEO_LOOP_DESCRIPTION" : {
      "comment" : "Description for VideoLoop preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimized for seamless silent loops. Encodes with x264 at CRF 23 (roughly 3–9 Mbps variable bitrate), strips audio, limits the shortest edge to 1080 px for web playback, and warns when clips exceed 15 seconds so you can trim before autoplay."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimalisert for sømløse, stille looper. Koder med x264 på CRF 23 (ca. 3–9 Mbps variabel bithastighet), fjerner lyd, begrenser korteste kant til 1080 px og varsler når klipp varer lenger enn 15 sekunder slik at du kan trimme før autoplay."
          }
        }
      }
    },
    "PRESET_VIDEO_LOOP_WITH_SOUND_DESCRIPTION" : {
      "comment" : "Description for VideoLoop with sound preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Same x264 settings as the muted loop but keeps every audio track as 128 kbps AAC while still capping the shortest edge at 1080 px."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samme x264-innstillinger som den stille loopen, men beholder alle lydspor som 128 kbps AAC samtidig som korteste kant begrenses til 1080 px."
          }
        }
      }
    },
