    },
    "Limit proxy resolution. Lower resolutions create smaller files for faster editing." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrens proxyoppløsning. Lavere oppløsninger gir mindre filer for raskere redigering."
          }
        }
      }
    },
    "Limit the output resolution. Unlimited preserves source resolution." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrens utdataoppløsningen. Ubegrenset bevarer kildeoppløsningen."
          }
        }
      }
    },
    "Limits encoding tools to produce output that is easier for decoders to process. Improves playback compatibility on older or less powerful devices (like set-top boxes and mobile phones) at the cost of slightly reduced compression efficiency. Recommended for content targeting a wide range of playback devices." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrenser kodingsverktøyene slik at utdataene blir enklere for dekodere å behandle. Forbedrer avspillingskompatibilitet på eldre eller mindre kraftige enheter (som set-top-bokser og mobiltelefoner), på bekostning av litt redusert komprimeringseffektivitet. Anbefales for innhold rettet mot et bredt utvalg avspillingsenheter."
          }
        }
      }
    },
