    },
    "OCR converts picture-based subtitles (Blu-ray PGS, DVD VOBSUB) to SRT text. It reads the original subtitle images from the source file — no audio processing required." : {
      "comment" : "A description of how Tesseract OCR works.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OCR konverterer bildebaserte undertekster (Blu-ray PGS, DVD VOBSUB) til SRT-tekst. Den leser de opprinnelige undertekstbildene fra kildefilen – ingen lydbehandling kreves."
          }
        }
      }
    },
    "OCR Engine" : {
