    "Auto matches the source (10-bit sources encode as 10-bit, otherwise 8-bit). Force 8-bit or 10-bit if you need a specific depth." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto følger kilden (10-biters kilder kodes som 10-bit, ellers 8-bit). Tving 8-bit eller 10-bit hvis du trenger en bestemt dybde."
          }
        }
      }
    },
    "Auto-detected subtitle stream language overrides this when present in the source file." : {
