    "PRESET_ANIMATED_AVIF_DESCRIPTION" : {
      "comment" : "Description for Animated AVIF preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File extension: .avif | A modern, highly efficient image format with animation support. Uses AV1 codec for compression, specifically the svtav1 encoder. Automatically deinterlaces if needed using yadif=3. Limits resolution to 720 pixels on short end."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filendelse: .avif | Moderne, svært effektivt bildeformat med animasjonsstøtte. Bruker AV1-kodek for komprimering, spesifikt svtav1-enkoderen. Oppløsningen er begrenset til 720 piksler på kortsiden."
          }
        }
      }
    },
    "PRESET_AUDIO_AAC_STEREO_DESCRIPTION" : {
      "comment" : "Description for Audio AAC Stereo preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio only stereo down mix AAC-file."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare lyd. Stereo nedmiks AAC-fil."
          }
        }
      }
    },
    "PRESET_AUDIO_WAV_DESCRIPTION" : {
      "comment" : "Description for Audio WAV preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio only uncompressed WAV, keeping all audio channels if possible."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare lyd. Ukomprimert WAV, beholder alle lydkanaler hvis mulig."
          }
        }
      }
    },
    "PRESET_CUSTOM_DESCRIPTION" : {
      "comment" : "Description for Custom preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom FFMPEG preset. You do not need to write ffmpeg or input parameters. Only the output parameters. Ignores global metadata removal tags"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personlig forhåndsinnstilling. Du trenger ikke skrive ‘ffmpeg’ eller input-parametre. Kun enkoder-parametre. Ignorerer globale parametre for fjerning av metadata."
          }
        }
      }
    },
    "PRESET_HEVC_PROXY_DESCRIPTION" : {
      "comment" : "Description for HECV Proxy 1080p preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proxy format based on HEVC codec. 10-bit 6 Mbps. Retains all audio channels as uncompressed PCM."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proxy-format basert på HEVC (.h265) kodeken. 10-bit 6 Mbps. Beholder alle lydkanaler som ukomprimert PCM-lyd."
          }
        }
      }
    },
    "PRESET_PRORES_DESCRIPTION" : {
      "comment" : "Description for ProRes preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ProRes (yuv422p10) for edit-friendly masters. Includes the first video and audio streams, retains 24-bit PCM audio, and targets standard ProRes bitrates."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ProRes (yuv422p10) for redigeringsklare mastere. Inkluderer første video- og lydspor, beholder 24-bit PCM-lyd og sikter mot standard ProRes-bithastigheter."
          }
        }
      }
    },
    "PRESET_STREAM_COPY_DESCRIPTION" : {
      "comment" : "Description for Stream Copy preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy audio and video streams into a new file. Most useful when combined with trimming or merging."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopier lyd og videostrømmer inn i en ny fil. Mest nyttig i kombinasjon med trimming eller sammenslåing."
          }
        }
      }
    },
    "PRESET_TV_QUALITY_4K_DESCRIPTION" : {
      "comment" : "Description for TV Quality 4K preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broadcast 4K delivery. Hardware HEVC (10-bit 4:2:2) targets 60 Mbps, preserves all audio as 24-bit PCM, and limits the shortest edge to 2160 px."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4K-leveranse for TV. Maskinvareakselerert HEVC (10-bit 4:2:2) sikter mot 60 Mbps, beholder all lyd som 24-bit PCM og begrenser korteste kant til 2160 piksler."
          }
        }
      }
    },
    "PRESET_TV_QUALITY_HD_DESCRIPTION" : {
      "comment" : "Description for TV Quality HD preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broadcast-ready 1080p. Hardware HEVC (10-bit 4:2:2) targets 18 Mbps and keeps every audio channel as 24-bit PCM. Shortest edge limited to 1080 px."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendeklar 1080p. Maskinvareakselerert HEVC (10-bit 4:2:2) sikter mot 18 Mbps og beholder alle lydkanaler som 24-bit PCM. Korteste kant begrenses til 1080 piksler."
          }
        }
      }
    },
    "PRESET_VIDEO_LOOP_DESCRIPTION" : {
      "comment" : "Description for VideoLoop preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimized for seamless silent loops. Encodes with x264 at CRF 23 (3–9 Mbps variable bitrate), strips audio, and limits the shortest edge to 1080 px for web playback."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimalisert for sømløse, stille looper. Koder med x264 på CRF 23 (3–9 Mbps variabel bithastighet), fjerner lyd og begrenser korteste kant til 1080 piksler for web-avspilling."
          }
        }
      }
    },
    "PRESET_VIDEO_LOOP_WITH_AUDIO_DESCRIPTION" : {
      "comment" : "Description for VideoLoop with Audio preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seamless loops that retain audio. Encodes video with x264 at CRF 23 (3–9 Mbps), mixes the first audio track to stereo if needed, and stores audio as 192 kbps AAC while limiting the shortest edge to 1080 px."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sømløse looper med lyd. Koder video med x264 på CRF 23 (3–9 Mbps), mikser første lydspor til stereo ved behov og lagrer lyden som 192 kbps AAC, samtidig som korteste kant begrenses til 1080 piksler."
          }
        }
      }
    },
